<?xml version="1.0" encoding="UTF-8"?>
<!--
  Eclipse JDT formatter profile for Spotless.
  Key setting: lineSplit = 120.

  This profile is intentionally minimal: it relies on Eclipse defaults except for
  the max line width.
-->
<profiles version="23">
  <profile kind="CodeFormatterProfile" name="Spotless" version="23">
    <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="120"/>

    <!-- Keep indentation compatible with the existing code style (spaces, 4-wide). -->
    <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
    <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
    <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>
  </profile>
</profiles>
